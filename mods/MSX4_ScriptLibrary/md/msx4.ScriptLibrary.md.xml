<?xml version="1.0" encoding="utf-8" ?>

<mdscript name="JP_ScriptLibrary_MD" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
   <cues>

      <library name="SL_RefreshPlayerShips" purpose="run_actions">
         <params>
            <param name="Excluded" default="null"/>
         </params>
         <actions>
            <do_if value="global.$SL_PlayerShips? and typeof global.$SL_PlayerShips != datatype.group">
               <remove_value name="global.$SL_PlayerShips"/>
            </do_if>
            <create_group groupname="global.$SL_PlayerShips" chance="if not global.$SL_PlayerShips? then 100 else 0"/>

            <set_value name="$PlayerShips" exact="[]"/>
            <find_ship_by_true_owner name="$PlayerShips" space="player.galaxy" faction="faction.player" unit="false" normalcluster="true" explorationcluster="true" venturercluster="true" multiple="true" append="true" excluded="$Excluded">
               <match class="class.spacesuit" negate="true"/>
            </find_ship_by_true_owner>
            <add_to_group groupname="global.$SL_PlayerShips" list="$PlayerShips" replace="true"/>
         </actions>
      </library>

      <cue name="SL_Setup_MD">
         <conditions>
            <check_any>
               <event_game_started/>
               <event_game_loaded/>
            </check_any>
         </conditions>
         <actions>
            <debug_text filter="scripts" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '[TSE-TRACE] source=sl_setup_md ship=none phase=setup event=setup_start result=active reason=success'"/>

            <set_value name="$DEBUG" exact="0"/>
            <do_if value="$DEBUG gt 0">
               <set_value name="$_DebugFolderName" exact="'JP_ScriptLibrary.logs'"/>
               <set_value name="$_DebugScriptName" exact="'SL_Setup_MD'"/>
               <set_value name="$_DebugFileName" exact="'sl.Setup.md.xml.log'"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'" append="false"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~ ' + $_DebugScriptName + '.xml ~ SCRIPT_START ~~' + ''"/>
            </do_if>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

            <!-- group ~ $SL_PlayerShips -->
            <set_value name="$_TracePlayerShipsBefore" exact="if global.$SL_PlayerShips? then global.$SL_PlayerShips.count else 0"/>
            <run_actions ref="md.JP_ScriptLibrary_MD.SL_RefreshPlayerShips"/>
            <debug_text filter="scripts" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '[TSE-TRACE] source=sl_setup_md ship=none phase=player_ship_group event=group_refresh result=complete reason=success before_count=%1 after_count=%2'.[$_TracePlayerShipsBefore, global.$SL_PlayerShips.count]"/>

            <!-- table[] ~ key = $_Ship, value = [$_IdleStartTime] -->
            <do_if value="global.$SL_IdleShips? and typeof global.$SL_IdleShips != datatype.table">
               <remove_value name="global.$SL_IdleShips"/>
            </do_if>
            <set_value name="global.$SL_IdleShips" exact="table[]" chance="(if not global.$SL_IdleShips? then 100 else 0)"/>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

            <do_if value="$DEBUG gt 0">
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~ ' + $_DebugScriptName + '.xml ~ SCRIPT_END ~~'"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'"/>
            </do_if>
            <debug_text filter="scripts" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '[TSE-TRACE] source=sl_setup_md ship=none phase=setup event=setup_end result=success reason=success player_ship_count=%1'.[global.$SL_PlayerShips.count]"/>
            <remove_value name="$_TracePlayerShipsBefore"/>

         </actions>
         <cues>

            <cue name="SL_RefreshPlayerShips_MD" instantiate="true">
               <conditions>
                  <check_any>
                     <event_player_built_ship/>
                     <event_player_owned_destroyed/>
                     <check_all>
                        <check_any>
                           <event_object_entered space="player.galaxy"/>
                           <event_contained_object_changed_true_owner space="player.galaxy" owner="faction.player"/>
                           <event_contained_object_changed_true_owner space="player.galaxy" previous="faction.player"/>
                        </check_any>
                        <check_value value="(event.name == 'event_contained_object_changed_true_owner' or event.param.isplayerowned) and event.param.isoperational"/>
                     </check_all>
                  </check_any>
                  <check_value value="event.param.isrealclass.ship and not event.param.isunit and not event.param.isrealclass.spacesuit"/>
               </conditions>
               <actions>
                  <set_value name="$_TracePlayerShipsBefore" exact="global.$SL_PlayerShips.count"/>
                  <set_value name="$_TraceWasMember" exact="global.$SL_PlayerShips.indexof.{event.param} gt 0"/>
                  <debug_text filter="scripts" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '[TSE-TRACE] source=sl_player_ship_group ship=%1 phase=refresh event=%2 result=pending reason=success before_count=%3 was_member=%4'.[event.param, event.name, $_TracePlayerShipsBefore, $_TraceWasMember]"/>
                  <run_actions ref="md.JP_ScriptLibrary_MD.SL_RefreshPlayerShips">
                     <param name="Excluded" value="if event.name == 'event_player_owned_destroyed' then event.param else null"/>
                  </run_actions>
                  <set_value name="$_TraceIsMember" exact="global.$SL_PlayerShips.indexof.{event.param} gt 0"/>
                  <debug_text filter="scripts" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '[TSE-TRACE] source=sl_player_ship_group ship=%1 phase=refresh event=%2 result=%3 reason=success before_count=%4 after_count=%5 is_member=%6'.[event.param, event.name, if not $_TraceWasMember and $_TraceIsMember then 'added' else (if $_TraceWasMember and not $_TraceIsMember then 'removed' else 'unchanged'), $_TracePlayerShipsBefore, global.$SL_PlayerShips.count, $_TraceIsMember]"/>
                  <remove_value name="$_TraceIsMember"/>
                  <remove_value name="$_TraceWasMember"/>
                  <remove_value name="$_TracePlayerShipsBefore"/>
               </actions>
            </cue>

      <cue name="SL_DebugInfo_MD" instantiate="false" checkinterval="1s">
         <actions>

            <set_value name="$DEBUG" exact="md.JP_ScriptLibrary_MD.SL_Setup_MD.$DEBUG"/>
            <do_if value="$DEBUG gt 0">
               <set_value name="$_DebugFolderName" exact="'JP_ScriptLibrary.logs'"/>
               <set_value name="$_DebugScriptName" exact="'SL_DebugInfo_MD'"/>
               <set_value name="$_DebugFileName" exact="'sl.Debug.md.xml.log'"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'" append="false"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~ ' + $_DebugScriptName + '.xml ~ SCRIPT_START ~~' + ''"/>
            </do_if>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

            <do_if value="$DEBUG gt 0 and @global.$SL_PlayerShips != null">
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + 'global.$SL_PlayerShips.count %1'.[@global.$SL_PlayerShips.count]"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'"/>
               <do_for_each name="$_Ship" in="global.$SL_PlayerShips">
                  <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '$_Ship: %1 [%2]'.[@$_Ship.knownname, @$_Ship.idcode]"/>
               </do_for_each>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'"/>
            </do_if>

            <do_if value="$DEBUG gt 0 and @global.$SL_IdleShips != null">
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + 'global.$SL_IdleShips.keys.count %1'.[@global.$SL_IdleShips.keys.count]"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'"/>
               <do_for_each name="$_Ship"  valuename="$_IdleStartTime" in="global.$SL_IdleShips">
                  <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '$_Ship: %1 [%2] ~ %3'.[@$_Ship.knownname, @$_Ship.idcode, @$_IdleStartTime]"/>
               </do_for_each>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'"/>
            </do_if>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

            <do_if value="$DEBUG gt 0">
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~ ' + $_DebugScriptName + '.xml ~ SCRIPT_END ~~'"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'"/>
            </do_if>

         </actions>
      </cue>

      <cue name="SL_ManageIdleReturnHome_MD" instantiate="true" checkinterval="1s">
         <conditions>
            <check_value value="@global.$SL_IdleShips.keys.count"/>
         </conditions>
         <actions>

            <set_value name="$DEBUG" exact="md.JP_ScriptLibrary_MD.SL_Setup_MD.$DEBUG"/>
            <do_if value="$DEBUG gt 0">
               <set_value name="$_DebugFolderName" exact="'JP_ScriptLibrary.logs'"/>
               <set_value name="$_DebugScriptName" exact="'SL_ManageIdleReturnHome_MD'"/>
               <set_value name="$_DebugFileName" exact="'sl.ManageIdleReturnHome.md.xml.log'"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'" append="false"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~ ' + $_DebugScriptName + '.xml ~ SCRIPT_START ~~' + ''"/>
            </do_if>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

            <do_for_each name="$_Ship" valuename="$_IdleStartTime" in="global.$SL_IdleShips" reverse="true">
               <set_value name="$_IdleOrderPresent" exact="false"/>
               <do_for_each name="$_Order" in="$_Ship.orders">
                  <do_if value="$_Order.id == 'JP_lib_IdleReturnHome'">
                     <set_value name="$_IdleOrderPresent" exact="true"/>
                     <break/>
                  </do_if>
               </do_for_each>
               <set_value name="$_IdleTime" exact="if $_Ship.defaultorder.id == 'Assist' 
                                                            then @$_Ship.commander.defaultorder.$IDLE_TIME
                                                            else @$_Ship.defaultorder.$IDLE_TIME"/>
               <do_if value="$_IdleOrderPresent and ((player.age - $_IdleStartTime) lt $_IdleTime)">
                  <continue/>
               </do_if>
               <!-- Cancel only the registered idle helper and orders explicitly
                    tagged as its children.  A broadcast signal handled via
                    this.ship.order only cancels the current immediate child and
                    therefore lets the interrupted IdleReturnHome order restart. -->
               <do_for_each name="$_Order" in="$_Ship.orders.clone">
                  <do_if value="$_Order.exists and ($_Order.id == 'JP_lib_IdleReturnHome' or @$_Order.$IDLE_RETURN_HOME)">
                     <cancel_order order="$_Order"/>
                  </do_if>
               </do_for_each>
               <remove_value name="global.$SL_IdleShips.{$_Ship}"/>
               <substitute_text source="$_Ship.knownname" text="$_ResultName">
                  <replace string="'\033#FFCEFBA1# ~ Idle\033X'" with="''"/>
               </substitute_text>
               <do_if value="$_Ship.knownname != $_ResultName">
                  <set_object_name object="$_Ship" name="$_ResultName"/>
               </do_if>
            </do_for_each>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

            <do_if value="$DEBUG gt 0">
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~ ' + $_DebugScriptName + '.xml ~ SCRIPT_END ~~'"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBMD] ' + player.age + ' *** JP_ScriptLibrary_MD:' + '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'"/>
            </do_if>

         </actions>
      </cue>

         </cues>
      </cue>

   </cues>
</mdscript>
