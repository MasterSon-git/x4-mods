<?xml version="1.0" encoding="utf-8"?>

<aiscript name="jp.lib.IdleReturnHome" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="aiscripts.xsd">

   <order id="JP_lib_IdleReturnHome" name="{8888888, 40}" category="internal" infinite="false" allowinloop="false" canplayercancel="true">
      <params>
         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
         <param name="IDLE_TIME"      type="internal" default="null"/>
         <param name="IDLE_MOVE_TO"   type="internal" default="null"/>
         <param name="WHERE_TO_MOVE"  type="internal" default="null"/>
         <param name="START_POSITION" type="internal" default="null"/>
         <param name="IDLE_FOLLOW"    type="internal" default="null"/>
         <param name="WHO_TO_FOLLOW"  type="internal" default="null"/>
         <param name="IDLE_DOCKING"   type="internal" default="null"/>
         <param name="FIND_STATION"   type="internal" default="null"/>
         <param name="WHERE_TO_DOCK"  type="internal" default="null"/>
         <param name="STRICT_BLACKLIST" type="internal" default="false"/>
         <param name="USE_KNOWN_PATH"   type="internal" default="this.ship.isplayerowned"/>
         <param name="cannotdock"        type="internal" default="false"/>
         <param name="FAILED_MOVE"       type="internal" default="false"/>
         <param name="FAILED_FOLLOW"     type="internal" default="false"/>
         <param name="FAILED_DOCK"       type="internal" default="false"/>
         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
         <param name="debugchance" type="internal" default="0"/>
         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      </params>
   </order>

   <interrupts>
      <handler comment="Handler to cancel IdleReturnHome Orders, add this also to all sub orders created by IdleReturnHome">
         <conditions>
            <event_object_signalled object="this.ship" param="'Cancel_IdleReturnHome'"/>
         </conditions>
         <actions>
            <cancel_order order="this.ship.order"/>
         </actions>
      </handler>
   </interrupts>

   <init>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <set_value name="$_Ship" exact="this.ship"/>
      <set_value name="$_DefaultOrderParamRef" exact="if $_Ship.defaultorder.id == 'Assist' then $_Ship.commander.defaultorder else $_Ship.defaultorder"/>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <set_value name="global.$SL_IdleShips.{$_Ship}" exact="player.age"/>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <set_value name="$DEBUG" exact="@$_DefaultOrderParamRef.$DEBUG"/>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <do_if value="$DEBUG gt 0">
         <set_value name="$_DebugFolderName" exact="@$_DefaultOrderParamRef.$DEBUG_FOLDER_NAME"/>
         <set_value name="$_DebugScriptName" exact="'jp.lib.IdleReturnHome'"/>
         <set_value name="$_DebugFileName"   exact="$_Ship.idcode + '.' + $_DebugScriptName + '.xml.log'"/>
      </do_if>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
   </init>

   <attention min="unknown">
      <actions>

         <label name="INIT_LBL"/>
         <do_if value="$DEBUG gt 0">
            <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'" append="false"/>
            <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[' + player.systemtime.{'%F - %X'} + '] ' + '~~ ' + $_DebugScriptName + '.xml ~ SCRIPT_START ~~' + '\n'"/>
         </do_if>

         <substitute_text source="$_Ship.knownname" text="$_ResultName">
            <replace string="'\033#FFCEFBA1# ~ Idle\033X'" with="''"/>
         </substitute_text>
         <do_if value="$_Ship.knownname == $_ResultName">
            <set_object_name object="$_Ship" name="$_Ship.knownname + '\033#FFCEFBA1# ~ Idle\033X'"/>
         </do_if>

         <do_if value="not $IDLE_MOVE_TO and not $IDLE_FOLLOW and not $IDLE_DOCKING">
            <set_value name="$IDLE_MOVE_TO" exact="true" chance="100"/>
            <set_value name="$WHERE_TO_MOVE" exact="$START_POSITION"/>
         </do_if>

         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

         <set_command_action commandaction="commandaction.standingby"/>

         <include_interrupt_actions ref="GetBlacklistgroup"/>

         <do_if value="$STRICT_BLACKLIST">
            <!-- Escape always precedes station, position, follow or dock targets.
                 Pause the ordinary idle timer so a long multi-sector escape is
                 not cancelled and restarted halfway through. -->
            <do_if value="$_Ship.sector.isblacklisted.{blacklisttype.sectortravel}.{$blacklistgroup}.{$_Ship}">
               <remove_value name="global.$SL_IdleShips.{$_Ship}"/>
               <run_script name="'jp.lib.EscapeTravelBlacklist'" result="$_EscapeResult">
                  <param name="USE_KNOWN_PATH" value="$USE_KNOWN_PATH"/>
               </run_script>
               <set_value name="global.$SL_IdleShips.{$_Ship}" exact="player.age"/>
               <do_if value="$_EscapeResult != 'success'">
                  <wait exact="$IDLE_TIME"/>
                  <resume label="END_LBL"/>
               </do_if>
            </do_if>

            <set_value name="$_IdleActionFailed" exact="false"/>
            <do_if value="$cannotdock">
               <!-- Vanilla DockAt reports failure to this order through callerid. -->
               <set_value name="$FAILED_DOCK" exact="true"/>
               <set_value name="$cannotdock" exact="false"/>
               <set_value name="$_IdleActionFailed" exact="true"/>
               <edit_order_param order="this.assignedcontrolled.order" param="'FAILED_DOCK'" value="true"/>
               <edit_order_param order="this.assignedcontrolled.order" param="'cannotdock'" value="false"/>
            </do_if>

            <!-- Idle Move: preflight and execution use the same effective policy. -->
            <do_if value="$IDLE_MOVE_TO and not $FAILED_MOVE">
               <set_value name="$_IdleMoveAllowed" exact="false"/>
               <find_sector name="$_AccessibleIdleMoveSector" space="player.galaxy" macro="$WHERE_TO_MOVE.{1}.macro" accessgrantedto="$_Ship.owner"/>
               <do_if value="$_AccessibleIdleMoveSector == $WHERE_TO_MOVE.{1} and
                             not $WHERE_TO_MOVE.{1}.isblacklisted.{blacklisttype.sectoractivity}.{$blacklistgroup}.{$_Ship} and
                             not $WHERE_TO_MOVE.{1}.isblacklisted.{blacklisttype.sectortravel}.{$blacklistgroup}.{$_Ship}">
                  <get_global_path component="$_IdlePathComponent" resultdistance="$_IdlePathDistance" refobject="$_Ship"
                                   useblacklist="$blacklistgroup" useknownpath="$USE_KNOWN_PATH" uselocalhighways="not $_Ship.iscapitalship">
                     <start object="$_Ship"/>
                     <end object="$WHERE_TO_MOVE.{1}"/>
                  </get_global_path>
                  <set_value name="$_IdleMoveAllowed" exact="$_IdlePathDistance ge 0"/>
               </do_if>
               <do_if value="$_IdleMoveAllowed and $_Ship.distanceto.[$WHERE_TO_MOVE.{1}, $WHERE_TO_MOVE.{2}] gt 10km">
                  <run_script name="'move.generic'" result="$_IdleMoveSuccess">
                     <param name="destination" value="$WHERE_TO_MOVE.{1}"/>
                     <param name="position" value="$WHERE_TO_MOVE.{2}"/>
                     <param name="strictblacklist" value="true"/>
                     <param name="useknownpath" value="$USE_KNOWN_PATH"/>
                     <param name="recallsubordinates" value="false"/>
                  </run_script>
                  <do_if value="$_IdleMoveSuccess">
                     <resume label="END_LBL"/>
                  </do_if>
                  <set_value name="$FAILED_MOVE" exact="true"/>
                  <set_value name="$_IdleActionFailed" exact="true"/>
                  <edit_order_param order="this.assignedcontrolled.order" param="'FAILED_MOVE'" value="true"/>
               </do_if>
            </do_if>

            <!-- A successful Follow never returns.  Returning means the target
                 became invalid or Vanilla movement failed, so another action may run. -->
            <do_if value="$IDLE_FOLLOW and not $FAILED_FOLLOW">
               <set_value name="$_IdleFollowAllowed" exact="false"/>
               <do_if value="$WHO_TO_FOLLOW.exists and
                             not $WHO_TO_FOLLOW.isblacklisted.{blacklisttype.objectactivity}.{$blacklistgroup}.{$_Ship} and
                             not $WHO_TO_FOLLOW.sector.isblacklisted.{blacklisttype.sectoractivity}.{$blacklistgroup}.{$_Ship} and
                             not $WHO_TO_FOLLOW.sector.isblacklisted.{blacklisttype.sectortravel}.{$blacklistgroup}.{$_Ship}">
                  <find_sector name="$_AccessibleIdleFollowSector" space="player.galaxy" macro="$WHO_TO_FOLLOW.sector.macro" accessgrantedto="$_Ship.owner"/>
                  <do_if value="$_AccessibleIdleFollowSector == $WHO_TO_FOLLOW.sector">
                     <get_global_path component="$_IdlePathComponent" resultdistance="$_IdlePathDistance" refobject="$_Ship"
                                      useblacklist="$blacklistgroup" useknownpath="$USE_KNOWN_PATH" uselocalhighways="not $_Ship.iscapitalship">
                        <start object="$_Ship"/>
                        <end object="$WHO_TO_FOLLOW"/>
                     </get_global_path>
                     <set_value name="$_IdleFollowAllowed" exact="$_IdlePathDistance ge 0"/>
                  </do_if>
               </do_if>
               <do_if value="$_IdleFollowAllowed">
                  <run_script name="'order.move.follow'">
                     <param name="IDLE_RETURN_HOME" value="true"/>
                     <param name="target" value="$WHO_TO_FOLLOW"/>
                     <param name="STRICT_BLACKLIST" value="true"/>
                     <param name="USE_KNOWN_PATH" value="$USE_KNOWN_PATH"/>
                  </run_script>
                  <set_value name="$FAILED_FOLLOW" exact="true"/>
                  <set_value name="$_IdleActionFailed" exact="true"/>
                  <edit_order_param order="this.assignedcontrolled.order" param="'FAILED_FOLLOW'" value="true"/>
               </do_if>
            </do_if>

            <!-- DockAndWait stays infinite on success.  Its documented callerid
                 channel makes a failed DockAt observable after this order restarts. -->
            <do_if value="$IDLE_DOCKING and not $FAILED_DOCK">
               <set_value name="$_IdleDockAllowed" exact="false"/>
               <do_if value="@$WHERE_TO_DOCK.dockingallowed.{$_Ship} and
                             not $WHERE_TO_DOCK.isblacklisted.{blacklisttype.objectactivity}.{$blacklistgroup}.{$_Ship} and
                             not $WHERE_TO_DOCK.sector.isblacklisted.{blacklisttype.sectoractivity}.{$blacklistgroup}.{$_Ship} and
                             not $WHERE_TO_DOCK.sector.isblacklisted.{blacklisttype.sectortravel}.{$blacklistgroup}.{$_Ship}">
                  <find_sector name="$_AccessibleIdleDockSector" space="player.galaxy" macro="$WHERE_TO_DOCK.sector.macro" accessgrantedto="$_Ship.owner"/>
                  <do_if value="$_AccessibleIdleDockSector == $WHERE_TO_DOCK.sector">
                     <get_global_path component="$_IdlePathComponent" resultdistance="$_IdlePathDistance" refobject="$_Ship"
                                      useblacklist="$blacklistgroup" useknownpath="$USE_KNOWN_PATH" uselocalhighways="not $_Ship.iscapitalship">
                        <start object="$_Ship"/>
                        <end object="$WHERE_TO_DOCK"/>
                     </get_global_path>
                     <set_value name="$_IdleDockAllowed" exact="$_IdlePathDistance ge 0"/>
                  </do_if>
               </do_if>

               <do_if value="not $_IdleDockAllowed and $FIND_STATION">
                  <find_station name="$_FoundStations" space="player.galaxy" multiple="true">
                     <match knownto="$_Ship.owner"/>
                     <match checkoperational="true"/>
                     <match_relation_to faction="$_Ship.owner" comparison="ge" relation="dock"/>
                     <match_use_blacklist object="$_Ship" type="blacklisttype.sectoractivity" group="$blacklistgroup"/>
                     <match_use_blacklist object="$_Ship" type="blacklisttype.objectactivity" group="$blacklistgroup"/>
                  </find_station>
                  <create_list name="$_ReachableDockStations"/>
                  <do_for_each name="$_FoundStation" in="$_FoundStations">
                     <do_if value="$_FoundStation.dockingallowed.{$_Ship} and
                                   not $_FoundStation.sector.isblacklisted.{blacklisttype.sectortravel}.{$blacklistgroup}.{$_Ship}">
                        <find_sector name="$_AccessibleIdleDockSector" space="player.galaxy" macro="$_FoundStation.sector.macro" accessgrantedto="$_Ship.owner"/>
                        <do_if value="$_AccessibleIdleDockSector == $_FoundStation.sector">
                           <get_global_path component="$_IdlePathComponent" resultdistance="$_IdlePathDistance" refobject="$_Ship"
                                            useblacklist="$blacklistgroup" useknownpath="$USE_KNOWN_PATH" uselocalhighways="not $_Ship.iscapitalship">
                              <start object="$_Ship"/>
                              <end object="$_FoundStation"/>
                           </get_global_path>
                           <do_if value="$_IdlePathDistance ge 0">
                              <append_to_list name="$_ReachableDockStations" exact="$_FoundStation"/>
                           </do_if>
                        </do_if>
                     </do_if>
                  </do_for_each>
                  <run_script name="'jp.lib.SortByEstimatedTravelTime'" result="$_ReachableDockStations">
                     <param name="LIST" value="$_ReachableDockStations"/>
                  </run_script>
                  <do_if value="$_ReachableDockStations.count">
                     <set_value name="$WHERE_TO_DOCK" exact="$_ReachableDockStations.{1}"/>
                     <set_value name="$_IdleDockAllowed" exact="true"/>
                  </do_if>
               </do_if>

               <do_if value="$_IdleDockAllowed">
                  <create_order object="$_Ship" id="'DockAndWait'" immediate="true">
                     <param name="IDLE_RETURN_HOME" value="true"/>
                     <param name="destination" value="$WHERE_TO_DOCK"/>
                     <param name="timeout" value="999h"/>
                     <param name="internalorder" value="true"/>
                     <param name="callerid" value="this.assignedcontrolled.order"/>
                  </create_order>
                  <wait exact="1ms"/>
               </do_if>
            </do_if>

            <do_if value="$_IdleActionFailed">
               <!-- Backoff is only reached after an observed child failure and
                    only when no alternative action remained successful. -->
               <set_value name="global.$SL_IdleShips.{$_Ship}" exact="player.age"/>
               <wait exact="$IDLE_TIME"/>
            </do_if>
            <do_else>
               <!-- No action was needed or currently allowed: remain in the
                    normal idle state until the existing MD timer wakes TSE. -->
               <wait/>
            </do_else>
            <resume label="END_LBL"/>
         </do_if>

         <!-- Preserve the original non-strict fallback for other users of the library. -->
         <label name="IDLE_MOVE_TO_LBL"/>
         <do_if value="$IDLE_MOVE_TO">
            <do_if value="$_Ship.distanceto.[$WHERE_TO_MOVE.{1}, $WHERE_TO_MOVE.{2}] gt 10km">
               <create_order id="'JP_lib_MoveToPosition'" object="$_Ship" immediate="true">
                  <param name="SECTOR" value="$WHERE_TO_MOVE.{1}"/>
                  <param name="POSITION" value="$WHERE_TO_MOVE.{2}"/>
               </create_order>
               <wait exact="1ms"/>
            </do_if>
            <do_else>
               <wait exact="$IDLE_TIME"/>
            </do_else>
         </do_if>

         <label name="IDLE_FOLLOW_LBL"/>
         <do_if value="$IDLE_FOLLOW">
            <do_if value="$WHO_TO_FOLLOW == null">
               <set_value name="$IDLE_MOVE_TO" exact="true"/>
               <resume label="IDLE_MOVE_TO_LBL"/>
            </do_if>
            <create_order object="$_Ship" id="'Follow'" immediate="true">
               <param name="IDLE_RETURN_HOME" value="true"/>
               <param name="target" value="$WHO_TO_FOLLOW"/>
            </create_order>
            <wait exact="1ms"/>
         </do_if>

         <label name="IDLE_DOCKING_LBL"/>
         <do_if value="$IDLE_DOCKING">
            <do_if value="not @$WHERE_TO_DOCK.dockingallowed.{$_Ship}">
               <do_if value="$FIND_STATION">
                  <find_station name="$_FoundStations" space="player.galaxy" multiple="true">
                     <match knownto="$_Ship.owner"/>
                     <match checkoperational="true"/>
                     <match_relation_to faction="$_Ship.owner" comparison="ge" relation="dock"/>
                  </find_station>
                  <run_script name="'jp.lib.SortByEstimatedTravelTime'" result="$_FoundStations">
                     <param name="LIST" value="$_FoundStations"/>
                  </run_script>
                  <do_for_each name="$_FoundStation" in="$_FoundStations">
                     <do_if value="$_FoundStation.dockingallowed.{$_Ship}">
                        <set_value name="$WHERE_TO_DOCK" exact="$_FoundStation"/>
                        <break/>
                     </do_if>
                  </do_for_each>
               </do_if>
               <do_if value="not @$WHERE_TO_DOCK.dockingallowed.{$_Ship}">
                  <set_value name="$IDLE_MOVE_TO" exact="true"/>
                  <resume label="IDLE_MOVE_TO_LBL"/>
               </do_if>
            </do_if>
            <create_order object="$_Ship" id="'DockAndWait'" immediate="true">
               <param name="IDLE_RETURN_HOME" value="true"/>
               <param name="destination" value="$WHERE_TO_DOCK"/>
               <param name="timeout" value="999h"/>
            </create_order>
            <wait exact="1ms"/>
         </do_if>

         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

         <label name="END_LBL"/>
         <do_if value="$DEBUG gt 0">
            <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[' + player.systemtime.{'%F - %X'} + '] ' + '~~ ' + $_DebugScriptName + '.xml ~ SCRIPT_END ~~'"/>
            <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n'"/>
         </do_if>

      </actions>
   </attention>

   <on_abort>
      <!-- If an external order aborts the escape while the ordinary idle timer
           is suspended, re-register the ship so the existing MD cleanup removes
           the idle name/state on its next pass. -->
      <do_if value="$STRICT_BLACKLIST and not @global.$SL_IdleShips.{$_Ship}">
         <set_value name="global.$SL_IdleShips.{$_Ship}" exact="player.age"/>
      </do_if>
   </on_abort>

</aiscript>
