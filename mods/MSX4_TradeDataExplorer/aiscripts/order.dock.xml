<?xml version="1.0" encoding="utf-8"?>

<diff xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://x4dynlib.access.ly\libraries\aiscripts.xsd">

   <add sel="/aiscript/init">
      <!-- Vanilla's Tide flee docks followers at the commander's shelter.
           TSE-G subordinates operate independently and handle their own Tide
           signal, so do not recall the distributed explorer fleet. -->
      <do_if value="$dockfollowers and @this.ship.defaultorder.id == 'JP_TradeSubscriptionExplorerG' and this.ship.subordinates.count gt 0">
         <set_value name="$dockfollowers" exact="false"/>
         <do_if value="@this.ship.defaultorder.$DEBUG gt 0">
            <debug_to_file directory="'JP_TradeSubscriptionExplorer.logs'" name="'TSE_Runtime.log'" text="'[TSEAI ] ' + player.age + ' *** order.dock:' + '[TSE-TRACE] source=tse_dock_at_diff ship=%1 phase=configuration event=dockfollowers_override result=disabled reason=tse_galaxy_commander subordinate_count=%2'.[this.ship.idcode, this.ship.subordinates.count]"/>
         </do_if>
      </do_if>
   </add>

</diff>
