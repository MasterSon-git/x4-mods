<?xml version="1.0" encoding="utf-8"?>

<diff xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://x4dynlib.access.ly\libraries\aiscripts.xsd">

   <add sel="/aiscript/order/params">
      <!-- Internal marker for the bounded TDE trade-data recovery attempt.
           Vanilla behavior remains unchanged when the marker is false. -->
      <param name="MSX4_TDE_TRADE_DATA_RECOVERY" type="internal" default="false"/>
   </add>

   <add sel="/aiscript/init">
      <!-- A failed recovery dock is handled by UpdateTradeData and must not
           emit Vanilla's player-facing order failure notification. -->
      <set_value name="$nofeedback" exact="true" chance="if $MSX4_TDE_TRADE_DATA_RECOVERY then 100 else 0"/>

      <!-- Vanilla's Tide flee docks followers at the commander's shelter.
           TDE-G subordinates operate independently and handle their own Tide
           signal, so do not recall the distributed explorer fleet. -->
      <do_if value="$dockfollowers and @this.ship.defaultorder.id == 'MSX4_TradeDataExplorerG' and this.ship.subordinates.count gt 0">
         <set_value name="$dockfollowers" exact="false"/>
         <do_if value="@this.ship.defaultorder.$DEBUG gt 0">
            <debug_to_file directory="'MSX4_TradeDataExplorer.logs'" name="'MSX4_TradeDataExplorer_Runtime.log'" text="'[MSX4-TDE-AI] ' + player.age + ' *** order.dock:' + '[MSX4-TDE-TRACE] source=tde_dock_at_diff ship=%1 phase=configuration event=dockfollowers_override result=disabled reason=tde_galaxy_commander subordinate_count=%2'.[this.ship.idcode, this.ship.subordinates.count]"/>
         </do_if>
      </do_if>
   </add>

   <!-- order.dock normally marks the caller's current order as failed when a
        dock cannot be assigned.  The TDE recovery path consumes the boolean
        return value itself and may continue with a closer radar approach. -->
   <replace sel="/aiscript/attention[@min='unknown']/actions//set_order_failed[@order='$thisship.order']">
      <do_if value="not $MSX4_TDE_TRADE_DATA_RECOVERY">
         <set_order_failed order="$thisship.order" text="$failuretext" recurring="$internalorder and ($thisship.order != $thisship.defaultorder)"/>
      </do_if>
   </replace>

</diff>
