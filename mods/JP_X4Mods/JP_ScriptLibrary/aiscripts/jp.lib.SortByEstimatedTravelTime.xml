<?xml version="1.0" encoding="utf-8"?>

<aiscript name="jp.lib.SortByEstimatedTravelTime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="aiscripts.xsd">

   <params>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <param name="LIST"    default="[]"/>
      <param name="REVERSE" default="false"/>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <param name="debugchance" default="0"/>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
   </params>

   <init>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <set_value name="$_Ship" exact="this.ship"/>
      <set_value name="$_DefaultOrderParamRef" exact="if $_Ship.defaultorder.id == 'Assist' then $_Ship.commander.defaultorder else $_Ship.defaultorder"/>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <set_value name="$DEBUG" exact="@$_DefaultOrderParamRef.$DEBUG"/>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <do_if value="$DEBUG gt 0">
         <set_value name="$_DebugFolderName" exact="@$_DefaultOrderParamRef.$DEBUG_FOLDER_NAME"/>
         <set_value name="$_DebugScriptName" exact="'jp.lib.SortByEstimatedTravelTime'"/>
         <set_value name="$_DebugFileName" exact="'TSE_Runtime.log'"/>
         <set_value name="$_TraceTargetIndex" exact="0"/>
      </do_if>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
   </init>

   <attention min="unknown">
      <actions>

         <label name="INIT_LBL"/>
         <do_if value="$DEBUG gt 0">
            <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBAI] ' + player.age + ' *** jp.lib.SortByEstimatedTravelTime:' + '[TSE-TRACE] source=sort_travel_time ship=%1 phase=lifecycle event=script_start result=active candidate_count=%2 reverse=%3'.[$_Ship.idcode, $LIST.count, $REVERSE]"/>
         </do_if>

         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

         <set_command_action commandaction="commandaction.calculating"/>

         <create_list name="$_SectorTravelTimes"/>
         <do_for_each name="$_ListEntry" in="$LIST">
            <do_if value="$DEBUG gt 0">
               <set_value name="$_TraceTargetIndex" operation="add" exact="1"/>
            </do_if>
            <estimate_travel_time ship="$_Ship" start="$_Ship" target="$_ListEntry" result="$_TravelTime"/>
            <do_if value="$DEBUG gt 0">
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBAI] ' + player.age + ' *** jp.lib.SortByEstimatedTravelTime:' + '[TSE-TRACE] source=sort_travel_time ship=%1 phase=estimate event=target_result result=%2 reason=%3 candidate_index=%4 target=%5 target_type=%6 travel_time=%7'.[$_Ship.idcode, if $_TravelTime ge 0 then 'accepted' else 'excluded', if $_TravelTime ge 0 then 'success' else 'no_known_path', $_TraceTargetIndex, $_ListEntry, if $_ListEntry.isclass.sector then 'sector' else 'object', $_TravelTime]"/>
            </do_if>
            <!-- X4 9.00 defines a negative result as no path; do not rank it before valid times. -->
            <do_if value="$_TravelTime ge 0">
               <append_to_list name="$_SectorTravelTimes" exact="[$_ListEntry, $_TravelTime]"/>
            </do_if>
         </do_for_each>
         <sort_list list="$_SectorTravelTimes" sortbyvalue="loop.element.{2}"/>
         <clear_list list="$LIST"/>
         <do_if value="@$_SectorTravelTimes.{1}.{1}.isclass.{class.sector}">
            <do_for_each name="$_Sector" in="$_SectorTravelTimes" reverse="true">
               <do_if value="$_Sector.{1} == $_Ship.sector">
                  <remove_from_list name="$_SectorTravelTimes" exact="$_Sector"/>
                  <append_to_list name="$LIST" exact="$_Ship.sector"/>
                  <break/>
               </do_if>
            </do_for_each>
         </do_if>
         <do_for_each name="$_SectorTravelTime" in="$_SectorTravelTimes">
            <append_to_list name="$LIST" exact="$_SectorTravelTime.{1}"/>
         </do_for_each>

         <do_if value="$REVERSE">
            <create_list name="$_ReversedList"/>
            <do_for_each name="$_Entry" in="$LIST" reverse="true">
               <append_to_list name="$_ReversedList" exact="$_Entry"/>
            </do_for_each>
            <clear_list list="$LIST"/>
            <append_list_elements name="$LIST" other="$_ReversedList"/>
         </do_if>
         <do_if value="$DEBUG gt 0">
            <set_value name="$_TraceTargetIndex" exact="0"/>
            <do_for_each name="$_TraceSortedTarget" in="$LIST">
               <set_value name="$_TraceTargetIndex" operation="add" exact="1"/>
               <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBAI] ' + player.age + ' *** jp.lib.SortByEstimatedTravelTime:' + '[TSE-TRACE] source=sort_travel_time ship=%1 phase=sort event=result_entry result=ordered reason=success candidate_index=%2 target=%3 target_type=%4'.[$_Ship.idcode, $_TraceTargetIndex, $_TraceSortedTarget, if $_TraceSortedTarget.isclass.sector then 'sector' else 'object']"/>
            </do_for_each>
         </do_if>

         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

         <label name="END_LBL"/>
         <do_if value="$DEBUG gt 0">
            <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[SLIBAI] ' + player.age + ' *** jp.lib.SortByEstimatedTravelTime:' + '[TSE-TRACE] source=sort_travel_time ship=%1 phase=lifecycle event=script_end result=success reason=success candidate_count=%2'.[$_Ship.idcode, $LIST.count]"/>
         </do_if>

         <return value="$LIST"/>

      </actions>
   </attention>

</aiscript>
