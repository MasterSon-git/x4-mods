<?xml version="1.0" encoding="utf-8"?>

<diff xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://x4dynlib.access.ly\libraries\aiscripts.xsd">

   <!-- Vanilla 9.00 initializes $orderdef from $order before entering this compatibility chain. -->
   <add sel="//do_if[@value=&quot;$orderdef.$id == 'SupplyFleet'&quot;]" pos="before">
      <do_if value="$orderdef.$id == 'JP_TradeSubscriptionExplorerG'">
         <set_value name="$added"/>
         <do_if value="@this.assignedcontrolled.order.isrunning">
            <clear_order_failure order="this.assignedcontrolled.order"/>
         </do_if>

         <!-- Recreate the inherited default order after promotion using the values saved below. -->
         <do_if value="$createdefaultorder?">
            <create_order id="$orderdef.$id" object="this.assignedcontrolled" default="true">
               <param name="OWNERLESS_SECTORS" value="$orderdef.$OWNERLESS_SECTORS"/>
               <param name="WHARFS" value="$orderdef.$WHARFS"/>
               <param name="SHIPYARDS" value="$orderdef.$SHIPYARDS"/>
               <param name="EQUIPMENTDOCKS" value="$orderdef.$EQUIPMENTDOCKS"/>
               <param name="TRADING_STATIONS" value="$orderdef.$TRADING_STATIONS"/>
               <param name="PIRATE_BASES" value="$orderdef.$PIRATE_BASES"/>
               <param name="RECYCLING_FACILITIES" value="$orderdef.$RECYCLING_FACILITIES"/>
               <param name="DEFENCE_STATIONS" value="$orderdef.$DEFENCE_STATIONS"/>
               <param name="FACTION_HEADQUARTERS" value="$orderdef.$FACTION_HEADQUARTERS"/>
               <param name="NON_SPECIAL_STATIONS" value="$orderdef.$NON_SPECIAL_STATIONS"/>
               <param name="CONSTRUCTION_SITES" value="$orderdef.$CONSTRUCTION_SITES"/>
               <param name="IDLE_TIME" value="$orderdef.$IDLE_TIME"/>
               <param name="IDLE_MOVE_TO" value="$orderdef.$IDLE_MOVE_TO"/>
               <param name="WHERE_TO_MOVE" value="$orderdef.$WHERE_TO_MOVE"/>
               <param name="START_POSITION" value="$orderdef.$START_POSITION"/>
               <param name="IDLE_FOLLOW" value="$orderdef.$IDLE_FOLLOW"/>
               <param name="WHO_TO_FOLLOW" value="$orderdef.$WHO_TO_FOLLOW"/>
               <param name="IDLE_DOCKING" value="$orderdef.$IDLE_DOCKING"/>
               <param name="FIND_STATION" value="$orderdef.$FIND_STATION"/>
               <param name="WHERE_TO_DOCK" value="$orderdef.$WHERE_TO_DOCK"/>
               <param name="SHOW_MESSAGES" value="$orderdef.$SHOW_MESSAGES"/>
               <param name="WRITE_TO_LOG" value="$orderdef.$WRITE_TO_LOG"/>
               <param name="ADD_ORDER_TAG" value="$orderdef.$ADD_ORDER_TAG"/>
               <param name="DEBUG" value="$orderdef.$DEBUG"/>
            </create_order>
         </do_if>
         <do_else>
            <!-- Keep a complete copy for the commander-destruction/promotion path. -->
            <set_value name="$orderdef.$OWNERLESS_SECTORS" exact="$order.$OWNERLESS_SECTORS"/>
            <set_value name="$orderdef.$WHARFS" exact="$order.$WHARFS"/>
            <set_value name="$orderdef.$SHIPYARDS" exact="$order.$SHIPYARDS"/>
            <set_value name="$orderdef.$EQUIPMENTDOCKS" exact="$order.$EQUIPMENTDOCKS"/>
            <set_value name="$orderdef.$TRADING_STATIONS" exact="$order.$TRADING_STATIONS"/>
            <set_value name="$orderdef.$PIRATE_BASES" exact="$order.$PIRATE_BASES"/>
            <set_value name="$orderdef.$RECYCLING_FACILITIES" exact="$order.$RECYCLING_FACILITIES"/>
            <set_value name="$orderdef.$DEFENCE_STATIONS" exact="$order.$DEFENCE_STATIONS"/>
            <set_value name="$orderdef.$FACTION_HEADQUARTERS" exact="$order.$FACTION_HEADQUARTERS"/>
            <set_value name="$orderdef.$NON_SPECIAL_STATIONS" exact="$order.$NON_SPECIAL_STATIONS"/>
            <set_value name="$orderdef.$CONSTRUCTION_SITES" exact="$order.$CONSTRUCTION_SITES"/>
            <set_value name="$orderdef.$IDLE_TIME" exact="$order.$IDLE_TIME"/>
            <set_value name="$orderdef.$IDLE_MOVE_TO" exact="$order.$IDLE_MOVE_TO"/>
            <set_value name="$orderdef.$WHERE_TO_MOVE" exact="$order.$WHERE_TO_MOVE"/>
            <set_value name="$orderdef.$START_POSITION" exact="[this.ship.sector, this.ship.position]"/>
            <set_value name="$orderdef.$IDLE_FOLLOW" exact="$order.$IDLE_FOLLOW"/>
            <set_value name="$orderdef.$WHO_TO_FOLLOW" exact="$order.$WHO_TO_FOLLOW"/>
            <set_value name="$orderdef.$IDLE_DOCKING" exact="$order.$IDLE_DOCKING"/>
            <set_value name="$orderdef.$FIND_STATION" exact="$order.$FIND_STATION"/>
            <set_value name="$orderdef.$WHERE_TO_DOCK" exact="$order.$WHERE_TO_DOCK"/>
            <set_value name="$orderdef.$SHOW_MESSAGES" exact="$order.$SHOW_MESSAGES"/>
            <set_value name="$orderdef.$WRITE_TO_LOG" exact="$order.$WRITE_TO_LOG"/>
            <set_value name="$orderdef.$ADD_ORDER_TAG" exact="$order.$ADD_ORDER_TAG"/>
            <set_value name="$orderdef.$DEBUG" exact="$order.$DEBUG"/>

            <run_script name="$scriptname">
               <param name="OWNERLESS_SECTORS" value="$order.$OWNERLESS_SECTORS"/>
               <param name="WHARFS" value="$order.$WHARFS"/>
               <param name="SHIPYARDS" value="$order.$SHIPYARDS"/>
               <param name="EQUIPMENTDOCKS" value="$order.$EQUIPMENTDOCKS"/>
               <param name="TRADING_STATIONS" value="$order.$TRADING_STATIONS"/>
               <param name="PIRATE_BASES" value="$order.$PIRATE_BASES"/>
               <param name="RECYCLING_FACILITIES" value="$order.$RECYCLING_FACILITIES"/>
               <param name="DEFENCE_STATIONS" value="$order.$DEFENCE_STATIONS"/>
               <param name="FACTION_HEADQUARTERS" value="$order.$FACTION_HEADQUARTERS"/>
               <param name="NON_SPECIAL_STATIONS" value="$order.$NON_SPECIAL_STATIONS"/>
               <param name="CONSTRUCTION_SITES" value="$order.$CONSTRUCTION_SITES"/>
               <param name="IDLE_TIME" value="$order.$IDLE_TIME"/>
               <param name="IDLE_MOVE_TO" value="$order.$IDLE_MOVE_TO"/>
               <param name="WHERE_TO_MOVE" value="$order.$WHERE_TO_MOVE"/>
               <param name="START_POSITION" value="[this.ship.sector, this.ship.position]"/>
               <param name="IDLE_FOLLOW" value="$order.$IDLE_FOLLOW"/>
               <param name="WHO_TO_FOLLOW" value="$order.$WHO_TO_FOLLOW"/>
               <param name="IDLE_DOCKING" value="$order.$IDLE_DOCKING"/>
               <param name="FIND_STATION" value="$order.$FIND_STATION"/>
               <param name="WHERE_TO_DOCK" value="$order.$WHERE_TO_DOCK"/>
               <param name="SHOW_MESSAGES" value="$order.$SHOW_MESSAGES"/>
               <param name="WRITE_TO_LOG" value="$order.$WRITE_TO_LOG"/>
               <param name="ADD_ORDER_TAG" value="$order.$ADD_ORDER_TAG"/>
               <param name="DEBUG" value="$order.$DEBUG"/>
            </run_script>
         </do_else>
      </do_if>
   </add>

</diff>
