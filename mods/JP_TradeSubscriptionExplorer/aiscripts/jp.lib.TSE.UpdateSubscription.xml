<?xml version="1.0" encoding="utf-8"?>

<aiscript name="jp.lib.TSE.UpdateSubscription" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="aiscripts.xsd">

   <order id="JP_lib_TSE_UpdateSubscription" name="{8888888, 1940}" category="internal" infinite="false" allowinloop="false" canplayercancel="true">
      <params>
         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
         <param name="SECTOR"  type="internal" default="null"/>
         <param name="STATION" type="internal" default="null"/>
         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
         <param name="debugchance" type="internal" default="0"/>
         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      </params>
      <location object="$STATION" condition="@$STATION != null"/>
   </order>

   <interrupts>
      <library>
         <!-- Validate against the current target state and the ship's effective Vanilla blacklist policy. -->
         <actions name="ValidateTarget">
            <set_value name="$_ValidationStatus" exact="'target_invalid'"/>
            <set_value name="$_Station" exact="null"/>
            <do_if value="$STATION.exists">
               <set_value name="$_Station" exact="if $STATION.isconstruction then $STATION.buildstorage else $STATION"/>
               <do_if value="$_Station.exists">
                  <do_if value="$_Station.hastradesubscription">
                     <set_value name="$_ValidationStatus" exact="'already_current'"/>
                  </do_if>
                  <do_else>
                     <find_sector name="$_AccessibleTargetSector" space="player.galaxy" macro="$_Station.sector.macro" accessgrantedto="$_Ship.owner"/>
                     <do_if value="$_AccessibleTargetSector != $_Station.sector">
                        <set_value name="$_ValidationStatus" exact="'target_disallowed'"/>
                     </do_if>
                     <do_else>
                        <include_interrupt_actions ref="GetBlacklistgroup"/>
                        <!-- Construction sites deliberately require both the site and its
                             buildstorage to pass Object Activity. -->
                        <do_if value="$STATION.isblacklisted.{blacklisttype.objectactivity}.{$blacklistgroup}.{$_Ship} or
                                      $_Station.isblacklisted.{blacklisttype.objectactivity}.{$blacklistgroup}.{$_Ship} or
                                      $_Station.sector.isblacklisted.{blacklisttype.sectoractivity}.{$blacklistgroup}.{$_Ship} or
                                      $_Station.sector.isblacklisted.{blacklisttype.sectortravel}.{$blacklistgroup}.{$_Ship}">
                           <set_value name="$_ValidationStatus" exact="'target_disallowed'"/>
                        </do_if>
                        <do_else>
                           <get_global_path component="$_PathComponent" resultdistance="$_PathDistance" refobject="$_Ship"
                                            useblacklist="$blacklistgroup" useknownpath="true" uselocalhighways="not $_Ship.iscapitalship">
                              <start object="$_Ship"/>
                              <end object="$_Station"/>
                           </get_global_path>
                           <set_value name="$_ValidationStatus" exact="if $_PathDistance ge 0 then 'valid' else 'no_valid_path'"/>
                        </do_else>
                     </do_else>
                  </do_else>
               </do_if>
            </do_if>
         </actions>
      </library>
      <handler>
         <conditions>
            <check_any>
               <event_object_destroyed object="$STATION"/>
               <event_object_destroyed object="$_Station"/>
            </check_any>
         </conditions>
         <actions>
            <set_value name="$_Result" exact="'target_invalid'"/>
            <abort_called_scripts resume="END_LBL"/>
         </actions>
      </handler>
      <handler ref="AttackHandler"/>
      <handler ref="MissileLockHandler" />
      <handler ref="ScannedHandler"/>
      <handler ref="InspectedHandler"/>
      <handler ref="FoundAbandonedHandler"/>
      <handler ref="FoundLockboxHandler"/>
      <handler ref="ResupplyHandler"/>
      <handler ref="TideHandler"/>
   </interrupts>

   <init>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <set_value name="$_Ship" exact="this.ship"/>
      <set_value name="$_DefaultOrderParamRef" exact="if $_Ship.defaultorder.id == 'Assist' then $_Ship.commander.defaultorder else $_Ship.defaultorder"/>
      <set_value name="$_Result" exact="'target_invalid'"/>
      <set_value name="$_Station" exact="if $STATION.exists and $STATION.isconstruction then $STATION.buildstorage else $STATION"/>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <set_value name="$DEBUG" exact="@$_DefaultOrderParamRef.$DEBUG"/>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
      <do_if value="$DEBUG gt 0">
         <set_value name="$_DebugFolderName" exact="'JP_TradeSubscriptionExplorer.logs'"/>
         <set_value name="$_DebugScriptName" exact="'jp.lib.TSE.UpdateSubscription'"/>
         <set_value name="$_DebugFileName" exact="$_Ship.idcode + '.' + $_DebugScriptName + '.xml.log'"/>
      </do_if>
      <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
   </init>

   <attention min="unknown">
      <actions>

         <label name="INIT_LBL"/>
         <do_if value="$DEBUG gt 0">
            <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'" append="false"/>
            <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[' + player.systemtime.{'%F - %X'} + '] ' + '~~ ' + $_DebugScriptName + '.xml ~ SCRIPT_START ~~' + '\n'"/>
         </do_if>

         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

         <set_command command="command.investigate"/>
         <set_command_action commandaction="commandaction.calculating"/>

         <!-- Do not depart for a destroyed, current, blacklisted, unknown-route or unreachable target. -->
         <include_interrupt_actions ref="ValidateTarget"/>
         <do_if value="$_ValidationStatus != 'valid'">
            <set_value name="$_Result" exact="$_ValidationStatus"/>
            <resume label="END_LBL"/>
         </do_if>

         <!-- Vanilla 9.00 owns all inter-sector gate, accelerator and highway handling. -->
         <do_if value="$_Ship.sector != $_Station.sector">
            <run_script name="'move.generic'" result="$_MoveSuccess">
               <param name="destination" value="$_Station.sector"/>
               <param name="endintargetsector" value="true"/>
               <param name="strictblacklist" value="true"/>
               <param name="useknownpath" value="true"/>
               <param name="uselocalhighways" value="not $_Ship.iscapitalship"/>
               <param name="recallsubordinates" value="false"/>
               <param name="debugchance" value="$debugchance"/>
            </run_script>
            <do_if value="not $_MoveSuccess">
               <set_value name="$_Result" exact="'move_failed'"/>
               <resume label="END_LBL"/>
            </do_if>
         </do_if>

         <!-- Time passed during travel: reject targets that became current or invalid. -->
         <include_interrupt_actions ref="ValidateTarget"/>
         <do_if value="$_ValidationStatus != 'valid'">
            <set_value name="$_Result" exact="$_ValidationStatus"/>
            <resume label="END_LBL"/>
         </do_if>
         <do_if value="$_Ship.sector != $_Station.sector">
            <set_value name="$_Result" exact="'move_failed'"/>
            <resume label="END_LBL"/>
         </do_if>

         <!-- Preserve the existing radar approach, but prevent it from reaching the legacy sector stack. -->
         <run_script name="'jp.lib.MoveToObject'" result="$_ApproachSuccess">
            <param name="OBJECT" value="$_Station"/>
            <param name="POSITION_SPACE" value="$_Ship"/>
            <param name="DISTANCE_TO_OBJECT" value="($_Ship.maxradarrange * 0.75)"/>
            <param name="FORCE_POSITION" value="false"/>
            <param name="FINISH_ON_APPROACH" value="true"/>
            <param name="SKIP_SECTOR_CHECK" value="true"/>
         </run_script>

         <include_interrupt_actions ref="ValidateTarget"/>
         <do_if value="$_ValidationStatus == 'already_current'">
            <resume label="SUCCESS_LBL"/>
         </do_if>
         <do_if value="$_ValidationStatus != 'valid'">
            <set_value name="$_Result" exact="$_ValidationStatus"/>
            <resume label="END_LBL"/>
         </do_if>
         <do_if value="not $_ApproachSuccess">
            <set_value name="$_Result" exact="'approach_failed'"/>
            <resume label="END_LBL"/>
         </do_if>

         <!-- No arbitrary timeout: leave only when Vanilla confirms the update or the target becomes invalid. -->
         <do_while value="$_ValidationStatus != 'already_current'">
            <wait exact="5s"/>
            <include_interrupt_actions ref="ValidateTarget"/>
            <do_if value="$_ValidationStatus != 'valid' and $_ValidationStatus != 'already_current'">
               <set_value name="$_Result" exact="$_ValidationStatus"/>
               <resume label="END_LBL"/>
            </do_if>
         </do_while>

         <label name="SUCCESS_LBL"/>
         <set_value name="$_Result" exact="'success'"/>

         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

         <run_script name="'jp.lib.GetFactionColorCode'" result="$_ObjectOwnerColor">
            <param name="FACTION" value="$STATION.owner"/>
         </run_script>
         <run_script name="'jp.lib.GetFactionColorCode'" result="$_ObjectSectorOwnerColor">
            <param name="FACTION" value="$STATION.sector.owner"/>
         </run_script>
         <run_script name="'jp.lib.GetFactionRelationColorCode'" result="$_ObjectOwnerRelationColorCode">
            <param name="FACTION_RELATION" value="$_Ship.owner.relation.{$STATION.relationto.{$_Ship}}.uivalue"/>
         </run_script>

         <!-- Renewed subscription at %5%1 [%2]\033X\nRelation to us: %7%3\033X\nSector: %6%4\033X -->
         <set_value name="$_Text" exact="{8888888, 1963}.[$STATION.knownname, $STATION.idcode, $_Ship.owner.relation.{$STATION.relationto.{$_Ship}}.uivalue, $STATION.sector.knownname, $_ObjectOwnerColor, $_ObjectSectorOwnerColor, $_ObjectOwnerRelationColorCode]"/>

         <run_script name="'jp.lib.MessageLog'">
            <param name="TEXT"               value="$_Text"/>
            <param name="INTERACTION_OBJECT" value="$STATION"/>
            <param name="MESSAGE_CHANCE"     value="3"/>
            <param name="LOG_CHANCE"         value="3"/>
         </run_script>

         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

         <apply_experience entity="$_Ship.pilot" experience="'JP_SHIP_TRADESUBSCRIPTION_UPDATED'"/>
         <apply_experience object="$_Ship" experience="'JP_SHIP_TRADESUBSCRIPTION_UPDATED'" role="entityrole.service"/>

         <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

         <label name="END_LBL"/>
         <do_if value="$DEBUG gt 0">
            <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'[' + player.systemtime.{'%F - %X'} + '] ' + '~~ ' + $_DebugScriptName + '.xml ~ SCRIPT_END ~~'"/>
            <debug_to_file directory="$_DebugFolderName" name="$_DebugFileName" text="'~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n'"/>
         </do_if>

         <return value="$_Result"/>

      </actions>
   </attention>

   <on_abort>
   </on_abort>

</aiscript>
